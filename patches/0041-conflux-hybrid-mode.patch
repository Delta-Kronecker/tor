+    } else if (conflux_policy_is_measured(policy)) {
+      /* DeltaTor: measured-throughput selection (4, 5 and 6). All three share
+       * the same per-set measurement, so roll every candidate's window first
+       * and only then decide how to turn the estimates into a choice. */
+      conflux_mthr_roll_all(cands, now);
+
+      bool exploit;
+      if (policy == CONFLUX_SET_SELECT_MEASURED_FASTEST) {
+        /* 5: pure exploit, always. */
+        exploit = true;
+      } else if (policy == CONFLUX_SET_SELECT_HYBRID) {
+        /* 6: weighted spread like mode 4 until every candidate has completed
+         * its first measurement window, then pure exploit like mode 5. */
+        const bool warmup = conflux_mthr_any_unmeasured(cands);
+        /* Log every phase change, including the very first phase (-1 = not
