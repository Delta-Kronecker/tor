+/** DeltaTor extension: roll every candidate's measurement window. Shared by the
+ * measured-throughput selection policies (4, 5 and 6) before they pick. */
+static void
+conflux_mthr_roll_all(smartlist_t *cands, time_t now)
+{
+  SMARTLIST_FOREACH_BEGIN(cands, conflux_set_candidate_t *, c) {
+    conflux_mthr_roll_window(c->cfx, now);
+  } SMARTLIST_FOREACH_END(c);
+}
+
+/** DeltaTor extension: true if some candidate set has not yet completed its
+ * first measurement window. The hybrid policy (ConfluxSetSelection 6) stays in
+ * the weighted warm-up phase while this is true and switches to pure exploit
+ * once every candidate has been measured at least once. */
+static bool
+conflux_mthr_any_unmeasured(const smartlist_t *cands)
+{
+  SMARTLIST_FOREACH_BEGIN(cands, conflux_set_candidate_t *, c) {
+    if (!c->cfx->mthr_measured_once) {
+      return true;
+    }
+  } SMARTLIST_FOREACH_END(c);
+  return false;
+}
+
+/** DeltaTor extension: weighted pick (ConfluxSetSelection 4). Spread new
+ * streams across the candidate sets in proportion to each set's measured real
+ * download throughput, plus a small floor so no set is ever starved and every
+ * set keeps getting fresh measurements. */
+static void
+conflux_mthr_pick_weighted(smartlist_t *cands, int n, int probe_log, time_t now,
+                           int *picked)
+{
+  uint64_t max_bps = 0;
+  SMARTLIST_FOREACH_BEGIN(cands, conflux_set_candidate_t *, c) {
+    if (c->cfx->mthr_bps > max_bps) {
+      max_bps = c->cfx->mthr_bps;
+    }
+  } SMARTLIST_FOREACH_END(c);
+
+  /* Floor = CONFLUX_MTHR_FLOOR_PCT% of the fastest set. With nothing
+   * measured yet every weight is equal, so new streams spread uniformly
+   * and every set is sampled. */
+  uint64_t floor = 1;
+  if (max_bps > 0) {
+    floor = max_bps * CONFLUX_MTHR_FLOOR_PCT / 100;
+    if (floor == 0) {
+      floor = 1;
+    }
+  }
+
+  uint64_t total = 0;
+  SMARTLIST_FOREACH_BEGIN(cands, conflux_set_candidate_t *, c) {
+    total += c->cfx->mthr_bps + floor;
+  } SMARTLIST_FOREACH_END(c);
+
+  const uint64_t r = crypto_rand_uint64(total);
+
+  if (conflux_mthr_detailed_logs(probe_log)) {
+    conflux_mthr_log_candidates(cands, n, true, floor);
+    log_notice(LD_CONFLUXMTHR,
+               "ConfluxProbe pick: candidates=%d max_bps=%"PRIu64"B/s "
+               "floor=%"PRIu64" total_weight=%"PRIu64" roll=%"PRIu64,
+               n, max_bps, floor, total, r);
+  }
+
+  uint64_t acc = 0;
+  bool chose = false;
+  SMARTLIST_FOREACH_BEGIN(cands, conflux_set_candidate_t *, c) {
+    acc += c->cfx->mthr_bps + floor;
+    if (!chose && r < acc) {
+      *picked = c_sl_idx;
+      chose = true;
+    }
+  } SMARTLIST_FOREACH_END(c);
+
+  if (probe_log) {
+    const conflux_set_candidate_t *chosen = smartlist_get(cands, *picked);
+    conflux_mthr_stats.picks++;
+    if (conflux_mthr_detailed_logs(probe_log)) {
+      log_notice(LD_CONFLUXMTHR,
+                 "ConfluxProbe chose set#%"PRIu64" bps=%"PRIu64"B/s",
+                 chosen->cfx->mthr_id, chosen->cfx->mthr_bps);
+    } else {
+      conflux_mthr_maybe_log_summary(cands, n, true, floor, total,
+                                     chosen->cfx->mthr_id, now);
+    }
+  }
+}
+
+/** DeltaTor extension: pure-exploit pick (ConfluxSetSelection 5, and the exploit
+ * phase of 6). Send the new stream to the set with the highest measured
+ * throughput; while nothing has been measured yet, spread uniformly at random
+ * so every set is sampled and a fastest one can be found. */
+static void
+conflux_mthr_pick_exploit(smartlist_t *cands, int n, int probe_log, time_t now,
+                          int *picked)
+{
+  uint64_t max_bps = 0;
+  int fastest = 0;
+  SMARTLIST_FOREACH_BEGIN(cands, conflux_set_candidate_t *, c) {
+    if (c->cfx->mthr_bps > max_bps) {
+      max_bps = c->cfx->mthr_bps;
+      fastest = c_sl_idx;
+    }
+  } SMARTLIST_FOREACH_END(c);
+
+  if (max_bps == 0) {
+    *picked = (int)crypto_rand_uint64((uint64_t)n);
+  } else {
+    *picked = fastest;
+  }
+
+  if (conflux_mthr_detailed_logs(probe_log)) {
+    conflux_mthr_log_candidates(cands, n, false, 0);
+    log_notice(LD_CONFLUXMTHR,
+               "ConfluxProbe exploit pick: candidates=%d max_bps=%"PRIu64
+               "B/s chosen=set#%"PRIu64,
+               n, max_bps, smartlist_get(cands, *picked)->cfx->mthr_id);
+  }
+
+  if (probe_log) {
+    const conflux_set_candidate_t *chosen = smartlist_get(cands, *picked);
+    conflux_mthr_stats.picks++;
+    if (conflux_mthr_detailed_logs(probe_log)) {
+      log_notice(LD_CONFLUXMTHR,
+                 "ConfluxProbe chose set#%"PRIu64" bps=%"PRIu64"B/s",
+                 chosen->cfx->mthr_id, chosen->cfx->mthr_bps);
+    } else {
+      conflux_mthr_maybe_log_summary(cands, n, false, 0, 0,
+                                     chosen->cfx->mthr_id, now);
+    }
+  }
+}
