diff --git a/src/app/config/or_options_st.h b/src/app/config/or_options_st.h
index d7aaf83..5217067 100644
--- a/src/app/config/or_options_st.h
+++ b/src/app/config/or_options_st.h
@@ -753,6 +753,12 @@ struct or_options_t {
   char *ConfluxClientUX_option;
   int ConfluxClientUX;
 
+  /** Number of legs to build per conflux set. 0 (default) means "use the
+   * consensus default" (cfx_num_legs, usually 2); any positive value overrides
+   * it so every set is always kept at exactly this many legs. This is a
+   * TorJet extension. */
+  int ConfluxNumLegs;
+
   /** The length of time that we think a consensus should be fresh. */
   int V3AuthVotingInterval;
   /** The length of time we think it will take to distribute votes. */
diff --git a/src/core/or/conflux_params.c b/src/core/or/conflux_params.c
index db9e21f..b8d36e1 100644
--- a/src/core/or/conflux_params.c
+++ b/src/core/or/conflux_params.c
@@ -239,6 +239,16 @@ conflux_params_get_num_legs_set(void)
   return num_legs_set;
 }
 
+/** TorJet extension: override the number of legs per set at runtime
+ * (e.g. from the CONFLUX SET control command). Ignored if out of range. */
+void
+conflux_params_set_num_legs(uint8_t n)
+{
+  if (n > 0 && n <= 16) {
+    num_legs_set = n;
+  }
+}
+
 /** Return the maximum number of legs per set. */
 uint8_t
 conflux_params_get_max_legs_set(void)
@@ -305,6 +315,16 @@ conflux_params_new_consensus(const networkstatus_t *ns)
                             NUM_LEGS_SET_DEFAULT,
                             NUM_LEGS_SET_MIN, NUM_LEGS_SET_MAX);
 
+  /* TorJet extension: the torrc ConfluxNumLegs option (0 = consensus default)
+   * overrides the consensus cfx_num_legs_set, so every set is always kept at
+   * exactly that many legs. */
+  {
+    const or_options_t *opts = get_options();
+    if (opts && opts->ConfluxNumLegs > 0) {
+      num_legs_set = opts->ConfluxNumLegs;
+    }
+  }
+
   max_legs_set =
     networkstatus_get_param(ns, "cfx_max_legs_set",
                             MAX_LEGS_SET_DEFAULT,
