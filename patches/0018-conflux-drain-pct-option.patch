From 0e2111ffbb118e302ab89eb8d7ab0ebeb8ac3e64 Mon Sep 17 00:00:00 2001
From: DeltaTor <deltator@example.com>
Date: Fri, 13 Nov 2026 07:02:34 +0330
Subject: [PATCH] conflux: expose cfx_drain_pct as the ConfluxDrainPct torrc
 option

DeltaTor extension: add a ConfluxDrainPct torrc option (0 = consensus
default, 1..255 = percentage) that overrides the consensus cfx_drain_pct
used by conflux_can_switch(). Upstream's own comment notes that when a set
uses more than two legs, cfx_drain_pct should be set to 100 so switching
between legs is not blocked. With ConfluxNumLegs 3 this matters for
throughput in both directions.
---
 src/app/config/config.c        |  5 +++++
 src/app/config/or_options_st.h |  7 +++++++
 src/core/or/conflux_params.c   | 10 ++++++++++
 3 files changed, 22 insertions(+)

diff --git a/src/app/config/config.c b/src/app/config/config.c
index 3b86c01..0e53742 100644
--- a/src/app/config/config.c
+++ b/src/app/config/config.c
@@ -391,6 +391,7 @@ static const config_var_t option_vars_[] = {
   V(ConfluxSetSelection,         INT,      "1"),
   V(ConfluxSetRttMax,            INT,      "0"),
   V(ConfluxSetRttPct,            INT,      "0"),
+  V(ConfluxDrainPct,             INT,      "0"),
   V(ConnLimit,                   POSINT,     "1000"),
   V(ConnDirectionStatistics,     BOOL,     "0"),
   V(ConstrainedSockets,          BOOL,     "0"),
@@ -3627,6 +3628,10 @@ options_validate_cb(const void *old_options_, void *options_, char **msg)
            "(percent of lowest-RTT sets to keep; 0 disables the filter)");
   }
 
+  if (options->ConfluxDrainPct < 0 || options->ConfluxDrainPct > 255) {
+    REJECT("ConfluxDrainPct must be between 0 (consensus default) and 255");
+  }
+
   if (options_validate_publish_server(old_options, options, msg) < 0)
     return -1;
 
diff --git a/src/app/config/or_options_st.h b/src/app/config/or_options_st.h
index 4b9cf5d..4170847 100644
--- a/src/app/config/or_options_st.h
+++ b/src/app/config/or_options_st.h
@@ -793,6 +793,13 @@ struct or_options_t {
    * always keeps at least one candidate so streams can still attach. */
   int ConfluxSetRttPct;
 
+  /** DeltaTor extension: override the consensus cfx_drain_pct used by the
+   * conflux leg scheduler. This is the percentage of a leg's congestion window
+   * that may still be in flight before conflux is allowed to switch away from
+   * it. 0 (default) keeps the consensus value. Upstream recommends 100 when a
+   * set uses more than two legs so switching is not blocked. */
+  int ConfluxDrainPct;
+
   /** The length of time that we think a consensus should be fresh. */
   int V3AuthVotingInterval;
   /** The length of time we think it will take to distribute votes. */
diff --git a/src/core/or/conflux_params.c b/src/core/or/conflux_params.c
index 463dbb6..fe67d50 100644
--- a/src/core/or/conflux_params.c
+++ b/src/core/or/conflux_params.c
@@ -396,6 +396,16 @@ conflux_params_new_consensus(const networkstatus_t *ns)
       CFX_DRAIN_PCT_MIN,
       CFX_DRAIN_PCT_MAX);
 
+  /* DeltaTor extension: the torrc ConfluxDrainPct option (0 = consensus
+   * default) overrides the consensus cfx_drain_pct. Upstream recommends 100
+   * when a set uses more than two legs. */
+  {
+    const or_options_t *opts = get_options();
+    if (opts && opts->ConfluxDrainPct > 0) {
+      cfx_drain_pct = (uint8_t) MIN(opts->ConfluxDrainPct, UINT8_MAX);
+    }
+  }
+
   max_ooo_queue_bytes = networkstatus_get_param(ns, "cfx_max_oooq_bytes",
       MAX_OOO_QUEUE_BYTES_DEFAULT,
       MAX_OOO_QUEUE_BYTES_MIN,
-- 
