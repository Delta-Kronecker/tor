diff --git a/src/core/or/circuituse.c b/src/core/or/circuituse.c
index a00bcf1..5d70e5c 100644
--- a/src/core/or/circuituse.c
+++ b/src/core/or/circuituse.c
@@ -3475,5 +3475,11 @@ circuit_read_valid_data(origin_circuit_t *circ, uint16_t relay_body_len)
   conflux_t *cfx = TO_CIRCUIT(circ)->conflux;
   if (cfx) {
     cfx->bytes_recv += relay_body_len;
+    /* DeltaTor: tell the measured-throughput probe that this set is moving
+     * bytes right now, so its estimate uses the time the set was really busy
+     * rather than the whole lazily rolled wall-clock window. */
+    if (relay_body_len > 0) {
+      conflux_note_recv_activity(cfx);
+    }
   }
 }
diff --git a/src/core/or/conflux_pool.c b/src/core/or/conflux_pool.c
index a0ec7f3..5577ecf 100644
--- a/src/core/or/conflux_pool.c
+++ b/src/core/or/conflux_pool.c
@@ -1547,6 +1547,25 @@ conflux_mthr_detailed_logs(int probe_log)
   return probe_log == 1 || probe_log == 2;
 }
 
+/** DeltaTor extension: record that the given set delivered payload bytes right
+ * now. Called from the data path (once per delivered relay cell) so the
+ * measured-throughput probe can tell how long a set was really busy instead of
+ * assuming it was busy for the whole lazily rolled wall-clock window. */
+void
+conflux_note_recv_activity(conflux_t *cfx)
+{
+  uint64_t now_ms;
+
+  if (!cfx) {
+    return;
+  }
+  now_ms = monotime_coarse_absolute_msec();
+  if (cfx->mthr_first_active_ms == 0) {
+    cfx->mthr_first_active_ms = now_ms;
+  }
+  cfx->mthr_last_active_ms = now_ms;
+}
+
 /** DeltaTor extension: source of the "set#N" labels used by the ConfluxProbeLog
  * lines. Process-local and diagnostics-only; assigned lazily when a set's
  * measurement window is first opened. */
@@ -1569,6 +1588,8 @@ conflux_mthr_roll_window(conflux_t *cfx, time_t now)
     cfx->mthr_id = conflux_mthr_next_id++;
     cfx->mthr_win_start = (uint64_t) now;
     cfx->mthr_prev_recv = cfx->bytes_recv;
+    cfx->mthr_first_active_ms = 0;
+    cfx->mthr_last_active_ms = 0;
     conflux_mthr_stats.windows++;
     if (probe_log) {
       log_notice(LD_CONFLUXMTHR,
@@ -1590,11 +1611,35 @@ conflux_mthr_roll_window(conflux_t *cfx, time_t now)
   const uint64_t delta = (cfx->bytes_recv >= cfx->mthr_prev_recv) ?
     cfx->bytes_recv - cfx->mthr_prev_recv : 0;
 
+  /* DeltaTor: the window is only rolled when a new stream is placed, so
+   * `elapsed` can include long stretches in which the set moved no bytes. Use
+   * the monotonic time during which bytes actually arrived instead, so a set
+   * that did all its work in a short burst is not reported as slow (and its
+   * estimate is not decayed just because the client went quiet). The elapsed
+   * wall clock stays the upper bound: the two clocks are independent. */
+  const bool had_activity = cfx->mthr_first_active_ms != 0 &&
+    cfx->mthr_last_active_ms >= cfx->mthr_first_active_ms;
+  uint64_t active_ms = had_activity ?
+    cfx->mthr_last_active_ms - cfx->mthr_first_active_ms : 0;
+  if (had_activity && active_ms == 0) {
+    /* A single delivered cell: keep it as a real (tiny) measurement. */
+    active_ms = 1;
+  }
+  if (active_ms > elapsed * 1000) {
+    active_ms = elapsed * 1000;
+  }
+  const uint64_t span_ms = active_ms ? active_ms : elapsed * 1000;
+
   cfx->mthr_prev_recv = cfx->bytes_recv;
   cfx->mthr_win_start = (uint64_t) now;
-
-  if (delta >= min_bytes && elapsed > 0) {
-    const uint64_t bps = delta / elapsed;
+  cfx->mthr_first_active_ms = 0;
+  cfx->mthr_last_active_ms = 0;
+
+  if (delta >= min_bytes && elapsed > 0 && span_ms > 0) {
+    /* Bytes per second over the time the set was actually moving bytes. */
+    const uint64_t bps = (delta * 1000) / span_ms;
+    const uint64_t span_s = span_ms / 1000;
+    const uint64_t span_frac = span_ms % 1000;
     /* Smooth across windows so a single bursty window does not dominate. */
     cfx->mthr_bps = (cfx->mthr_bps == 0) ? bps : (cfx->mthr_bps + bps) / 2;
     conflux_mthr_stats.rolls++;
@@ -1602,22 +1647,26 @@ conflux_mthr_roll_window(conflux_t *cfx, time_t now)
     if (conflux_mthr_detailed_logs(probe_log)) {
       log_notice(LD_CONFLUXMTHR,
                  "ConfluxProbe set#%"PRIu64" roll: elapsed=%"PRIu64"s "
-                 "delta=%"PRIu64"B bps=%"PRIu64"B/s smoothed=%"PRIu64"B/s "
-                 "(trusted)",
-                 cfx->mthr_id, elapsed, delta, bps, cfx->mthr_bps);
+                 "active=%"PRIu64".%03"PRIu64"s delta=%"PRIu64"B "
+                 "bps=%"PRIu64"B/s smoothed=%"PRIu64"B/s (trusted)",
+                 cfx->mthr_id, elapsed, span_s, span_frac, delta, bps,
+                 cfx->mthr_bps);
     }
   } else {
     /* Too little real traffic this window to trust: decay the estimate so the
      * set's floor share grows and it is probed again. */
+    const uint64_t span_s = span_ms / 1000;
+    const uint64_t span_frac = span_ms % 1000;
     cfx->mthr_bps /= 2;
     conflux_mthr_stats.rolls++;
     conflux_mthr_stats.decayed++;
     if (conflux_mthr_detailed_logs(probe_log)) {
       log_notice(LD_CONFLUXMTHR,
                  "ConfluxProbe set#%"PRIu64" roll: elapsed=%"PRIu64"s "
-                 "delta=%"PRIu64"B smoothed=%"PRIu64"B/s "
-                 "(low-traffic, decayed)",
-                 cfx->mthr_id, elapsed, delta, cfx->mthr_bps);
+                 "active=%"PRIu64".%03"PRIu64"s delta=%"PRIu64"B "
+                 "smoothed=%"PRIu64"B/s (low-traffic, decayed)",
+                 cfx->mthr_id, elapsed, span_s, span_frac, delta,
+                 cfx->mthr_bps);
     }
   }
 }
