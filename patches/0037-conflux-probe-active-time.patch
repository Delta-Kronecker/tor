+++ b/src/core/or/conflux_st.h
@@ -155,6 +155,14 @@ struct conflux_t {
   uint64_t mthr_prev_recv;
   uint64_t mthr_bps;
 
+  /** DeltaTor: monotonic-millisecond timestamps of the first and last payload
