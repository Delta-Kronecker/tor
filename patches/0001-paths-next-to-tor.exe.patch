+
+static const char *
+get_exe_dir(void)
+{
+  static int is_set = 0;
+  static char path[MAX_PATH*2+1];
+  DWORD len;
+  char *slash;
+
+  if (is_set)
+    return path[0] ? path : NULL;
+  is_set = 1;
+  len = GetModuleFileNameA(NULL, path, sizeof(path));
+  if (len == 0 || len >= sizeof(path)) {
+    path[0] = '\0';
+    return NULL;
+  }
+  slash = strrchr(path, '\\');
+  if (slash)
+    *slash = '\0';
+  else
+    path[0] = '\0';
+  return path[0] ? path : NULL;
+}
+
+static void
+chdir_to_exe_dir(void)
+{
+  const char *dir = get_exe_dir();
+  if (dir)
+    SetCurrentDirectoryA(dir);
+}
