+/** DeltaTor extension: emit the periodic ConfluxProbeLog 3 summary line, which
+ * replaces the per-event lines of levels 1 and 2. Like the rest of the probe it
+ * is produced lazily, when a stream is placed, so the line appears at most once
+ * per CONFLUX_MTHR_SUMMARY_SECS and only while the client is active. */
+static void
+conflux_mthr_maybe_log_summary(const smartlist_t *cands, int n, uint64_t floor,
+                               uint64_t total, uint64_t chosen_id, time_t now)
+{
+  if (conflux_mthr_stats.since == 0) {
+    conflux_mthr_stats.since = now;
+    return;
+  }
+  if (now < conflux_mthr_stats.since ||
+      (uint64_t)(now - conflux_mthr_stats.since) <
+      CONFLUX_MTHR_SUMMARY_SECS) {
+    return;
+  }
+
+  uint64_t top_id = 0;
+  uint64_t top_bps = 0;
+  int zero = 0;
+  SMARTLIST_FOREACH_BEGIN(cands, conflux_set_candidate_t *, c) {
+    if (c->cfx->mthr_bps == 0) {
+      zero++;
+    }
+    if (c->cfx->mthr_bps > top_bps) {
+      top_bps = c->cfx->mthr_bps;
+      top_id = c->cfx->mthr_id;
+    }
+  } SMARTLIST_FOREACH_END(c);
+
+  log_notice(LD_CONFLUXMTHR,
+             "ConfluxProbe summary: t=%"PRIu64"s windows=%"PRIu64" "
+             "rolls=%"PRIu64" (trusted=%"PRIu64" decayed=%"PRIu64") "
+             "picks=%"PRIu64" candidates=%d top=set#%"PRIu64" "
+             "top_bps=%"PRIu64"B/s floor=%"PRIu64" total_weight=%"PRIu64" "
+             "zero_sets=%d last=set#%"PRIu64,
+             (uint64_t)(now - conflux_mthr_stats.since),
+             conflux_mthr_stats.windows, conflux_mthr_stats.rolls,
+             conflux_mthr_stats.trusted, conflux_mthr_stats.decayed,
+             conflux_mthr_stats.picks, n, top_id, top_bps, floor, total, zero,
+             chosen_id);
+
+  memset(&conflux_mthr_stats, 0, sizeof(conflux_mthr_stats));
+  conflux_mthr_stats.since = now;
+}
