From 58702ee180c3833f7c0256bf1c6e9b9800d0364a Mon Sep 17 00:00:00 2001
From: DeltaTor <deltator@example.com>
Date: Fri, 13 Nov 2026 07:24:21 +0330
Subject: [PATCH] congestion: expose bandwidth-estimator params as torrc
 options

DeltaTor extension: add CongestionControlBweMin/EwmaCwndPct/EwmaMax/EwmaSs/
RttResetPct torrc options (0 = consensus default) that override the consensus
cc_bwe_min, cc_ewma_cwnd_pct, cc_ewma_max, cc_ewma_ss and cc_rtt_reset_pct
values. A smaller cc_bwe_min starts BDP estimation sooner so the congestion
window ramps up faster.
---
 src/app/config/config.c                 | 31 +++++++++++++++++++++++++
 src/app/config/or_options_st.h          | 25 ++++++++++++++++++++
 src/core/or/congestion_control_common.c | 20 ++++++++++++++++
 3 files changed, 76 insertions(+)

diff --git a/src/app/config/config.c b/src/app/config/config.c
index 68fa0e5..b7d53f0 100644
--- a/src/app/config/config.c
+++ b/src/app/config/config.c
@@ -403,6 +403,11 @@ static const config_var_t option_vars_[] = {
   V(CongestionControlCwndIncPctSs, INT,    "0"),
   V(CongestionControlCwndIncRate, INT,     "0"),
   V(CongestionControlCwndMin,    INT,      "0"),
+  V(CongestionControlBweMin,     INT,      "0"),
+  V(CongestionControlEwmaCwndPct, INT,     "0"),
+  V(CongestionControlEwmaMax,    INT,      "0"),
+  V(CongestionControlEwmaSs,     INT,      "0"),
+  V(CongestionControlRttResetPct, INT,     "0"),
   V(ConnLimit,                   POSINT,     "1000"),
   V(ConnDirectionStatistics,     BOOL,     "0"),
   V(ConstrainedSockets,          BOOL,     "0"),
@@ -3702,6 +3707,32 @@ options_validate_cb(const void *old_options_, void *options_, char **msg)
            "and 1000 cells");
   }
 
+  if (options->CongestionControlBweMin < 0 ||
+      options->CongestionControlBweMin > 20) {
+    REJECT("CongestionControlBweMin must be between 0 (consensus default) "
+           "and 20 SENDMEs");
+  }
+
+  if (options->CongestionControlEwmaCwndPct < 0 ||
+      options->CongestionControlEwmaCwndPct > 255) {
+    REJECT("CongestionControlEwmaCwndPct must be between 0 (consensus "
+           "default) and 255 percent");
+  }
+
+  if (options->CongestionControlEwmaMax < 0) {
+    REJECT("CongestionControlEwmaMax must be >= 0 (0 = consensus default)");
+  }
+
+  if (options->CongestionControlEwmaSs < 0) {
+    REJECT("CongestionControlEwmaSs must be >= 0 (0 = consensus default)");
+  }
+
+  if (options->CongestionControlRttResetPct < 0 ||
+      options->CongestionControlRttResetPct > 100) {
+    REJECT("CongestionControlRttResetPct must be between 0 (consensus default) "
+           "and 100 percent");
+  }
+
   if (options_validate_publish_server(old_options, options, msg) < 0)
     return -1;
 
diff --git a/src/app/config/or_options_st.h b/src/app/config/or_options_st.h
index 79ab1f2..fc48c3e 100644
--- a/src/app/config/or_options_st.h
+++ b/src/app/config/or_options_st.h
@@ -865,6 +865,31 @@ struct or_options_t {
    * larger floor prevents the window collapsing after loss. */
   int CongestionControlCwndMin;
 
+  /** DeltaTor extension: override the consensus cc_bwe_min, the minimum number
+   * of SENDMEs before bandwidth (BDP) estimation begins. 0 (default) keeps the
+   * consensus value (5). A smaller value starts estimation sooner. */
+  int CongestionControlBweMin;
+
+  /** DeltaTor extension: override the consensus cc_ewma_cwnd_pct, the number of
+   * congestion windows worth of SENDME acks used to smooth RTT/BDP. 0 (default)
+   * keeps the consensus value (50). */
+  int CongestionControlEwmaCwndPct;
+
+  /** DeltaTor extension: override the consensus cc_ewma_max, the maximum N for
+   * the N-count EWMA averaging of RTT and BDP. 0 (default) keeps the consensus
+   * value (10). */
+  int CongestionControlEwmaMax;
+
+  /** DeltaTor extension: override the consensus cc_ewma_ss, the maximum N for
+   * the N-count EWMA averaging of RTT in slow start. 0 (default) keeps the
+   * consensus value (2). */
+  int CongestionControlEwmaSs;
+
+  /** DeltaTor extension: override the consensus cc_rtt_reset_pct, the percent
+   * of the current RTT to use when resetting the minimum RTT. 0 (default) keeps
+   * the consensus value (100). */
+  int CongestionControlRttResetPct;
+
   /** The length of time that we think a consensus should be fresh. */
   int V3AuthVotingInterval;
   /** The length of time we think it will take to distribute votes. */
diff --git a/src/core/or/congestion_control_common.c b/src/core/or/congestion_control_common.c
index b6f46ea..4f37d6e 100644
--- a/src/core/or/congestion_control_common.c
+++ b/src/core/or/congestion_control_common.c
@@ -270,6 +270,26 @@ congestion_control_new_consensus_params(const networkstatus_t *ns)
         N_EWMA_SS_DFLT,
         N_EWMA_SS_MIN,
         N_EWMA_SS_MAX);
+
+  /* DeltaTor extension: the torrc congestion-estimator options (0 = consensus
+   * default) override the consensus cc_bwe_min, cc_ewma_* and cc_rtt_reset_pct
+   * values. A smaller cc_bwe_min starts BDP estimation sooner, letting the
+   * congestion window ramp up faster. */
+  {
+    const or_options_t *opts = get_options();
+    if (opts) {
+      if (opts->CongestionControlBweMin > 0)
+        bwe_sendme_min = (uint8_t) opts->CongestionControlBweMin;
+      if (opts->CongestionControlEwmaCwndPct > 0)
+        n_ewma_cwnd_pct = (uint8_t) opts->CongestionControlEwmaCwndPct;
+      if (opts->CongestionControlEwmaMax > 0)
+        n_ewma_max = (uint8_t) opts->CongestionControlEwmaMax;
+      if (opts->CongestionControlEwmaSs > 0)
+        n_ewma_ss = (uint8_t) opts->CongestionControlEwmaSs;
+      if (opts->CongestionControlRttResetPct > 0)
+        rtt_reset_pct = (uint8_t) opts->CongestionControlRttResetPct;
+    }
+  }
 }
 
 /**
