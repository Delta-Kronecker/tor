From 6e0054a9acef4562d824770ebb56e259829c6343 Mon Sep 17 00:00:00 2001
From: Delta-Kronecker <your-email@example.com>
Date: Wed, 12 Aug 2026 00:16:17 +0330
Subject: [PATCH] tor: add ConfluxNumSets torrc option (override
 cfx_max_prebuilt_set / max linked set)

---
 tor-src/src/app/config/config.c        |  5 +++++
 tor-src/src/app/config/or_options_st.h |  8 +++++++-
 tor-src/src/core/or/conflux_params.c   | 13 +++++++++++++
 3 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/src/app/config/config.c b/src/app/config/config.c
index 4e39b9e..755affc 100644
--- a/src/app/config/config.c
+++ b/src/app/config/config.c
@@ -385,6 +385,7 @@ static const config_var_t option_vars_[] = {
   VAR("ConfluxClientUX",         STRING,   ConfluxClientUX_option,
           "throughput"),
   V(ConfluxNumLegs,              INT,      "0"),
+  V(ConfluxNumSets,              INT,      "0"),
   V(ConnLimit,                   POSINT,     "1000"),
   V(ConnDirectionStatistics,     BOOL,     "0"),
   V(ConstrainedSockets,          BOOL,     "0"),
@@ -3591,6 +3592,10 @@ options_validate_cb(const void *old_options_, void *options_, char **msg)
     REJECT("ConfluxNumLegs must be between 0 (consensus default) and 16");
   }
 
+  if (options->ConfluxNumSets < 0 || options->ConfluxNumSets > 32) {
+    REJECT("ConfluxNumSets must be between 0 (consensus default) and 32");
+  }
+
   if (options_validate_publish_server(old_options, options, msg) < 0)
     return -1;
 
diff --git a/src/app/config/or_options_st.h b/src/app/config/or_options_st.h
index 5217067..416d6c7 100644
--- a/src/app/config/or_options_st.h
+++ b/src/app/config/or_options_st.h
@@ -757,7 +757,13 @@ struct or_options_t {
    * consensus default" (cfx_num_legs, usually 2); any positive value overrides
    * it so every set is always kept at exactly this many legs. This is a
    * TorJet extension. */
-  int ConfluxNumLegs;
+   int ConfluxNumLegs;
+
+  /** TorJet extension: target number of conflux sets to keep alive. 0 means
+   * "use the consensus default" (cfx_max_prebuilt_set, usually 3); any positive
+   * value overrides the prebuilt-set target and raises the linked-set cap to at
+   * least this many, so that many sets can coexist. */
+  int ConfluxNumSets;
 
   /** The length of time that we think a consensus should be fresh. */
   int V3AuthVotingInterval;
diff --git a/src/core/or/conflux_params.c b/src/core/or/conflux_params.c
index b8d36e1..cf6b322 100644
--- a/src/core/or/conflux_params.c
+++ b/src/core/or/conflux_params.c
@@ -330,6 +330,19 @@ conflux_params_new_consensus(const networkstatus_t *ns)
                             MAX_LEGS_SET_DEFAULT,
                             MAX_LEGS_SET_MIN, MAX_LEGS_SET_MAX);
 
+  /* TorJet extension: the torrc ConfluxNumSets option (0 = consensus default)
+   * overrides the consensus cfx_max_prebuilt_set target and raises the linked
+   * set cap to at least that many, so ConfluxNumSets sets can coexist. */
+  {
+    const or_options_t *opts = get_options();
+    if (opts && opts->ConfluxNumSets > 0) {
+      max_prebuilt_set = opts->ConfluxNumSets;
+      if (max_linked_set < opts->ConfluxNumSets) {
+        max_linked_set = opts->ConfluxNumSets;
+      }
+    }
+  }
+
   /* Params used by conflux.c */
   cfx_send_pct = networkstatus_get_param(ns, "cfx_send_pct",
       CFX_SEND_PCT_DFLT,
-- 
2.53.0.windows.1

