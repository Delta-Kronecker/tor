From f9217723e90e0c9749be925fc56b005200e37d00 Mon Sep 17 00:00:00 2001
From: DeltaTor <deltator@example.com>
Date: Fri, 13 Nov 2026 07:23:57 +0330
Subject: [PATCH] congestion: expose send-window growth as torrc options

DeltaTor extension: add CongestionControlCwndInit/CwndInc/CwndIncPctSs/
CwndIncRate/CwndMin torrc options (0 = consensus default) that override the
per-circuit cc_cwnd_init, cc_cwnd_inc, cc_cwnd_inc_pct_ss, cc_cwnd_inc_rate and
cc_cwnd_min consensus values. A larger initial window, a larger floor and
faster growth ramp up upload throughput sooner.
---
 src/app/config/config.c                 | 35 +++++++++++++++++++++++++
 src/app/config/or_options_st.h          | 27 +++++++++++++++++++
 src/core/or/congestion_control_common.c | 17 ++++++++++++
 3 files changed, 79 insertions(+)

diff --git a/src/app/config/config.c b/src/app/config/config.c
index 95cffca..68fa0e5 100644
--- a/src/app/config/config.c
+++ b/src/app/config/config.c
@@ -398,6 +398,11 @@ static const config_var_t option_vars_[] = {
   V(CircuitCellQueueLow,         INT,      "0"),
   V(OrConnHighWater,             INT,      "0"),
   V(OrConnLowWater,              INT,      "0"),
+  V(CongestionControlCwndInit,   INT,      "0"),
+  V(CongestionControlCwndInc,    INT,      "0"),
+  V(CongestionControlCwndIncPctSs, INT,    "0"),
+  V(CongestionControlCwndIncRate, INT,     "0"),
+  V(CongestionControlCwndMin,    INT,      "0"),
   V(ConnLimit,                   POSINT,     "1000"),
   V(ConnDirectionStatistics,     BOOL,     "0"),
   V(ConstrainedSockets,          BOOL,     "0"),
@@ -3667,6 +3672,36 @@ options_validate_cb(const void *old_options_, void *options_, char **msg)
     REJECT("OrConnLowWater must be >= 0 bytes (0 = consensus default)");
   }
 
+  if (options->CongestionControlCwndInit < 0 ||
+      options->CongestionControlCwndInit > 10000) {
+    REJECT("CongestionControlCwndInit must be between 0 (consensus default) "
+           "and 10000 cells");
+  }
+
+  if (options->CongestionControlCwndInc < 0 ||
+      options->CongestionControlCwndInc > 1000) {
+    REJECT("CongestionControlCwndInc must be between 0 (consensus default) "
+           "and 1000 cells");
+  }
+
+  if (options->CongestionControlCwndIncPctSs < 0 ||
+      options->CongestionControlCwndIncPctSs > 500) {
+    REJECT("CongestionControlCwndIncPctSs must be between 0 (consensus "
+           "default) and 500 percent");
+  }
+
+  if (options->CongestionControlCwndIncRate < 0 ||
+      options->CongestionControlCwndIncRate > 250) {
+    REJECT("CongestionControlCwndIncRate must be between 0 (consensus default) "
+           "and 250");
+  }
+
+  if (options->CongestionControlCwndMin < 0 ||
+      options->CongestionControlCwndMin > 1000) {
+    REJECT("CongestionControlCwndMin must be between 0 (consensus default) "
+           "and 1000 cells");
+  }
+
   if (options_validate_publish_server(old_options, options, msg) < 0)
     return -1;
 
diff --git a/src/app/config/or_options_st.h b/src/app/config/or_options_st.h
index 149515e..79ab1f2 100644
--- a/src/app/config/or_options_st.h
+++ b/src/app/config/or_options_st.h
@@ -838,6 +838,33 @@ struct or_options_t {
    * keeps the consensus value (16 KiB). */
   int OrConnLowWater;
 
+  /** DeltaTor extension: override the consensus cc_cwnd_init, the initial
+   * congestion window in cells. 0 (default) keeps the consensus value
+   * (4 * sendme_inc). A larger value skips part of slow start, improving
+   * upload throughput for short transfers. */
+  int CongestionControlCwndInit;
+
+  /** DeltaTor extension: override the consensus cc_cwnd_inc, the number of
+   * cells the congestion window grows by per update in congestion avoidance.
+   * 0 (default) keeps the consensus value (1). */
+  int CongestionControlCwndInc;
+
+  /** DeltaTor extension: override the consensus cc_cwnd_inc_pct_ss, the
+   * percent of the congestion window added per slow-start update. 0 (default)
+   * keeps the consensus value (100). Higher ramps up faster. */
+  int CongestionControlCwndIncPctSs;
+
+  /** DeltaTor extension: override the consensus cc_cwnd_inc_rate, the number of
+   * SENDME acks between congestion-window updates in congestion avoidance (it
+   * also gates slow-start exit). 0 (default) keeps the consensus value
+   * (sendme_inc). Higher updates the window more often. */
+  int CongestionControlCwndIncRate;
+
+  /** DeltaTor extension: override the consensus cc_cwnd_min, the minimum
+   * congestion window in cells. 0 (default) keeps the consensus value. A
+   * larger floor prevents the window collapsing after loss. */
+  int CongestionControlCwndMin;
+
   /** The length of time that we think a consensus should be fresh. */
   int V3AuthVotingInterval;
   /** The length of time we think it will take to distribute votes. */
diff --git a/src/core/or/congestion_control_common.c b/src/core/or/congestion_control_common.c
index 983ecbd..b6f46ea 100644
--- a/src/core/or/congestion_control_common.c
+++ b/src/core/or/congestion_control_common.c
@@ -329,6 +329,23 @@ congestion_control_init_params(congestion_control_t *cc,
         CWND_MIN_MIN,
         CWND_MIN_MAX);
 
+  /* DeltaTor extension: the torrc congestion-window options (0 = consensus
+   * default) override the consensus cc_cwnd_* values for this circuit. A larger
+   * initial window, a larger minimum window and faster growth ramp up upload
+   * throughput sooner. */
+  if (opts) {
+    if (opts->CongestionControlCwndInit > 0)
+      cc->cwnd = (uint64_t) opts->CongestionControlCwndInit;
+    if (opts->CongestionControlCwndInc > 0)
+      cc->cwnd_inc = (uint16_t) opts->CongestionControlCwndInc;
+    if (opts->CongestionControlCwndIncPctSs > 0)
+      cc->cwnd_inc_pct_ss = (uint16_t) opts->CongestionControlCwndIncPctSs;
+    if (opts->CongestionControlCwndIncRate > 0)
+      cc->cwnd_inc_rate = (uint8_t) opts->CongestionControlCwndIncRate;
+    if (opts->CongestionControlCwndMin > 0)
+      cc->cwnd_min = (uint16_t) opts->CongestionControlCwndMin;
+  }
+
   /* If the consensus says to use OG sendme, but torrc has
    * always-enabled, use the default "always" alg (vegas),
    * else use cached conensus alg. */
-- 
2.56.0.windows.2

