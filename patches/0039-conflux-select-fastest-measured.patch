+/** DeltaTor extension: log the candidate table for the detailed levels, or a
+ * single "unchanged" line while it repeats. `weights` is true for the weighted
+ * measured-throughput policy (each set also prints the weight it was given);
+ * false for the pure-exploit policy, where only the measured throughput
+ * matters. The floor is only used to compute the printed weights. */
+static void
+conflux_mthr_log_candidates(const smartlist_t *cands, int n, bool weights,
+                            uint64_t floor)
+{
+  const uint64_t digest = conflux_mthr_table_digest(cands);
+  if (conflux_mthr_table.valid && digest == conflux_mthr_table.digest &&
+      conflux_mthr_table.n == n) {
+    conflux_mthr_table.repeats++;
+    log_notice(LD_CONFLUXMTHR,
+               "ConfluxProbe candidates unchanged: sets=%d digest=%"PRIu64
+               " repeated=%"PRIu64,
+               n, digest, conflux_mthr_table.repeats);
+    return;
+  }
+
+  SMARTLIST_FOREACH_BEGIN(cands, conflux_set_candidate_t *, c) {
+    if (weights) {
+      log_notice(LD_CONFLUXMTHR,
+                 "ConfluxProbe candidate set#%"PRIu64" bps=%"PRIu64"B/s "
+                 "weight=%"PRIu64,
+                 c->cfx->mthr_id, c->cfx->mthr_bps, c->cfx->mthr_bps + floor);
+    } else {
+      log_notice(LD_CONFLUXMTHR,
+                 "ConfluxProbe candidate set#%"PRIu64" bps=%"PRIu64"B/s",
+                 c->cfx->mthr_id, c->cfx->mthr_bps);
+    }
+  } SMARTLIST_FOREACH_END(c);
+
+  conflux_mthr_table.valid = true;
+  conflux_mthr_table.digest = digest;
+  conflux_mthr_table.n = n;
+  conflux_mthr_table.repeats = 0;
+}
