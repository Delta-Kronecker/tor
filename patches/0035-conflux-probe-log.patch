+[[ConfluxProbeLog]] **ConfluxProbeLog** __NUM__::
+    DeltaTor extension: diagnostics for the measured-throughput set selection
+    (ConfluxSetSelection 4). 0 = off, 1 = log everything the mechanism does
+    (measurement windows, per-set throughput, candidate weights and the set it
+    picks) alongside tor's own log lines, 2 = log the same mechanism lines but
+    suppress all other tor log lines (errors are still shown), so the mechanism
+    can be verified in isolation. The mechanism lines use the "confluxmthr"
+    logging domain, so they can also be selected per target, for example with
+    "Log [confluxmthr]notice file conflux-probe.log". Valid range: 0-2.
+    (Default: 0)
+
 [[ConfluxDrainPct]] **ConfluxDrainPct** __NUM__::
     DeltaTor extension: override the consensus cfx_drain_pct, the percent of a
     leg's in-flight data that must drain before a switch to another leg is
@@ -988,7 +999,7 @@ forward slash (/) in the configuration file and on the command line.
     The currently recognized domains are: general, crypto, net, config, fs,
     protocol, mm, http, app, control, circ, rend, bug, dir, dirserv, or, edge,
     acct, hist, handshake, heartbeat, channel, sched, guard, consdiff, dos,
-    process, pt, btrack, and mesg.
+    process, pt, btrack, mesg, and confluxmthr.
     Domain names are case-insensitive. +
      +
     For example, "`Log [handshake]debug [~net,~mm]info notice stdout`" sends
diff --git a/src/app/config/config.c b/src/app/config/config.c
index 311e14e..c3eb3b7 100644
--- a/src/app/config/config.c
+++ b/src/app/config/config.c
@@ -393,6 +393,7 @@ static const config_var_t option_vars_[] = {
   V(ConfluxSetRttPct,            INT,      "0"),
   V(ConfluxProbeInterval,        INT,      "0"),
   V(ConfluxProbeMinBytes,        INT,      "0"),
+  V(ConfluxProbeLog,             INT,      "0"),
   V(ConfluxDrainPct,             INT,      "0"),
   V(ConfluxLowExitThreshold,     INT,      "0"),
   V(ConfluxMaxOooqBytes,         INT,      "0"),
@@ -3714,6 +3715,12 @@ options_validate_cb(const void *old_options_, void *options_, char **msg)
            "and 100000000 bytes");
   }
 
+  if (options->ConfluxProbeLog < 0 || options->ConfluxProbeLog > 2) {
+    REJECT("ConfluxProbeLog must be 0 (off), 1 (log the measured-throughput "
+           "set-selection mechanism alongside tor's own logs) or 2 (log only "
+           "the mechanism and suppress tor's own log lines)");
+  }
+
   if (options->ConfluxDrainPct < 0 || options->ConfluxDrainPct > 255) {
     REJECT("ConfluxDrainPct must be between 0 (consensus default) and 255");
   }
@@ -5307,6 +5314,12 @@ options_init_logs(const or_options_t *old_options, const or_options_t *options,
   if (options_init_log_granularity(options, validate_only) < 0)
     return -1;
 
+  /* DeltaTor extension: ConfluxProbeLog 2 makes logv() drop every line that is
+   * not from the conflux measured-throughput mechanism. Only change the global
+   * log state when we are really applying the options, not while validating. */
+  if (!validate_only)
+    log_set_conflux_mthr_only(options->ConfluxProbeLog >= 2);
+
   ok = 1;
   elts = smartlist_new();
 
