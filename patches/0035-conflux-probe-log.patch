diff --git a/src/lib/log/log.c b/src/lib/log/log.c
index 03cec47..341049f 100644
--- a/src/lib/log/log.c
+++ b/src/lib/log/log.c
@@ -131,6 +131,11 @@ static logfile_t *logfiles = NULL;
 /** Boolean: do we report logging domains? */
 static int log_domains_are_logged = 0;
 
+/** DeltaTor extension: when true, logv() drops every line that is not from the
+ * conflux measured-throughput mechanism (LD_CONFLUXMTHR); LOG_ERR is always
+ * kept. Set by ConfluxProbeLog 2 via log_set_conflux_mthr_only(). */
+static int conflux_mthr_only_logs = 0;
+
 #ifdef HAVE_SYSLOG_H
 /** The number of open syslog log handlers that we have.  When this reaches 0,
  * we can close our connection to the syslog facility. */
@@ -548,6 +553,14 @@ logv,(int severity, log_domain_mask_t domain, const char *funcname,
    * interesting and hard to diagnose effects */
   raw_assert(severity >= LOG_ERR && severity <= LOG_DEBUG);
 
+  /* DeltaTor extension: with ConfluxProbeLog 2, discard every line that is
+   * not from the conflux measured-throughput mechanism so its output can be
+   * read in isolation. Errors are always kept. */
+  if (conflux_mthr_only_logs && severity != LOG_ERR &&
+      !(domain & LD_CONFLUXMTHR)) {
+    return;
+  }
+
   LOCK_LOGS();
 
   if ((! (domain & LD_NOCB)) && pending_cb_messages
@@ -944,6 +957,16 @@ logs_set_domain_logging(int enabled)
   UNLOCK_LOGS();
 }
 
+/** DeltaTor extension: turn the "only the conflux measured-throughput
+ * mechanism" log filter on or off. See log_set_conflux_mthr_only() in log.h. */
+void
+log_set_conflux_mthr_only(int enabled)
+{
+  LOCK_LOGS();
+  conflux_mthr_only_logs = enabled;
+  UNLOCK_LOGS();
+}
+
 /** Add a log handler to accept messages when no other log is configured.
  */
 void
@@ -1249,6 +1272,7 @@ static const char *domain_list[] = {
