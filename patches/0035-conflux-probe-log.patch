diff --git a/src/core/or/conflux_pool.c b/src/core/or/conflux_pool.c
index 88b41b4..3845686 100644
--- a/src/core/or/conflux_pool.c
+++ b/src/core/or/conflux_pool.c
@@ -1523,6 +1523,11 @@ conflux_conn_is_keepalive(const entry_connection_t *conn)
  * exploration; there is no separate explore option). */
 #define CONFLUX_MTHR_FLOOR_PCT 10
 
+/** DeltaTor extension: source of the "set#N" labels used by the ConfluxProbeLog
+ * lines. Process-local and diagnostics-only; assigned lazily when a set's
+ * measurement window is first opened. */
+static uint64_t conflux_mthr_next_id = 1;
+
 /** DeltaTor extension: fold a set's elapsed measurement window into its
  * smoothed throughput estimate. Called lazily when a new stream is placed, so
  * no timer or per-cell accounting is needed: it only reads the set's existing
@@ -1532,11 +1537,20 @@ conflux_mthr_roll_window(conflux_t *cfx, time_t now)
 {
   const uint64_t interval = (uint64_t) conflux_params_get_probe_interval();
   const uint64_t min_bytes = (uint64_t) conflux_params_get_probe_min_bytes();
+  const int probe_log = conflux_params_get_probe_log();
 
   if (cfx->mthr_win_start == 0) {
-    /* First time this set is considered: open a fresh window. */
+    /* First time this set is considered: open a fresh window and give it an id
+     * for the diagnostic lines. */
+    cfx->mthr_id = conflux_mthr_next_id++;
     cfx->mthr_win_start = (uint64_t) now;
     cfx->mthr_prev_recv = cfx->bytes_recv;
+    if (probe_log) {
+      log_notice(LD_CONFLUXMTHR,
+                 "ConfluxProbe set#%"PRIu64" window opened: recv=%"PRIu64"B "
+                 "interval=%"PRIu64"s min_bytes=%"PRIu64"B",
+                 cfx->mthr_id, cfx->bytes_recv, interval, min_bytes);
+    }
     return;
   }
 
@@ -1558,10 +1572,24 @@ conflux_mthr_roll_window(conflux_t *cfx, time_t now)
     const uint64_t bps = delta / elapsed;
     /* Smooth across windows so a single bursty window does not dominate. */
     cfx->mthr_bps = (cfx->mthr_bps == 0) ? bps : (cfx->mthr_bps + bps) / 2;
+    if (probe_log) {
+      log_notice(LD_CONFLUXMTHR,
+                 "ConfluxProbe set#%"PRIu64" roll: elapsed=%"PRIu64"s "
+                 "delta=%"PRIu64"B bps=%"PRIu64"B/s smoothed=%"PRIu64"B/s "
+                 "(trusted)",
+                 cfx->mthr_id, elapsed, delta, bps, cfx->mthr_bps);
+    }
   } else {
     /* Too little real traffic this window to trust: decay the estimate so the
      * set's floor share grows and it is probed again. */
     cfx->mthr_bps /= 2;
+    if (probe_log) {
+      log_notice(LD_CONFLUXMTHR,
+                 "ConfluxProbe set#%"PRIu64" roll: elapsed=%"PRIu64"s "
+                 "delta=%"PRIu64"B smoothed=%"PRIu64"B/s "
+                 "(low-traffic, decayed)",
+                 cfx->mthr_id, elapsed, delta, cfx->mthr_bps);
+    }
   }
 }
 
@@ -1583,8 +1611,29 @@ conflux_pick_set_from_candidates(smartlist_t *cands, bool keepalive_balance,
   }
 
   const int policy = conflux_params_get_set_selection();
+  const int probe_log = conflux_params_get_probe_log();
   int picked = 0;
 
+  /* DeltaTor: emit one startup line the first time a stream is placed while
+   * ConfluxProbeLog is on, so it is obvious whether the measured-throughput
+   * mechanism is actually in use. */
+  static bool mthr_logged_startup = false;
+  if (probe_log && !mthr_logged_startup) {
+    mthr_logged_startup = true;
+    if (policy == CONFLUX_SET_SELECT_MEASURED) {
+      log_notice(LD_CONFLUXMTHR,
+                 "ConfluxProbe enabled: ConfluxProbeLog=%d, "
+                 "ConfluxSetSelection=4 (measured-throughput set selection)",
+                 probe_log);
+    } else {
+      log_notice(LD_CONFLUXMTHR,
+                 "ConfluxProbe enabled: ConfluxProbeLog=%d but "
+                 "ConfluxSetSelection=%d (not 4); measured-throughput "
+                 "selection is not active, so no probe traffic is produced",
+                 probe_log, policy);
+    }
+  }
+
   if (keepalive_balance) {
     uint64_t least = UINT64_MAX;
     SMARTLIST_FOREACH_BEGIN(cands, conflux_set_candidate_t *, c) {
@@ -1648,6 +1697,21 @@ conflux_pick_set_from_candidates(smartlist_t *cands, bool keepalive_balance,
       } SMARTLIST_FOREACH_END(c);
 
       const uint64_t r = crypto_rand_uint64(total);
+
+      if (probe_log) {
+        SMARTLIST_FOREACH_BEGIN(cands, conflux_set_candidate_t *, c) {
+          log_notice(LD_CONFLUXMTHR,
+                     "ConfluxProbe candidate set#%"PRIu64" bps=%"PRIu64"B/s "
+                     "weight=%"PRIu64,
+                     c->cfx->mthr_id, c->cfx->mthr_bps,
+                     c->cfx->mthr_bps + floor);
+        } SMARTLIST_FOREACH_END(c);
+        log_notice(LD_CONFLUXMTHR,
+                   "ConfluxProbe pick: candidates=%d max_bps=%"PRIu64"B/s "
+                   "floor=%"PRIu64" total_weight=%"PRIu64" roll=%"PRIu64,
+                   n, max_bps, floor, total, r);
+      }
+
       uint64_t acc = 0;
       bool chose = false;
       SMARTLIST_FOREACH_BEGIN(cands, conflux_set_candidate_t *, c) {
@@ -1657,6 +1721,13 @@ conflux_pick_set_from_candidates(smartlist_t *cands, bool keepalive_balance,
           chose = true;
         }
       } SMARTLIST_FOREACH_END(c);
+
+      if (probe_log) {
+        const conflux_set_candidate_t *chosen = smartlist_get(cands, picked);
+        log_notice(LD_CONFLUXMTHR,
+                   "ConfluxProbe chose set#%"PRIu64" bps=%"PRIu64"B/s",
+                   chosen->cfx->mthr_id, chosen->cfx->mthr_bps);
+      }
     } else {
       /* CONFLUX_SET_SELECT_FIRST and anything unknown: first candidate. */
       picked = 0;
diff --git a/src/core/or/conflux_st.h b/src/core/or/conflux_st.h
