diff --git a/src/core/or/conflux_params.c b/src/core/or/conflux_params.c
index 1d1c799..bc88211 100644
--- a/src/core/or/conflux_params.c
+++ b/src/core/or/conflux_params.c
@@ -288,6 +288,19 @@ conflux_params_get_probe_min_bytes(void)
   return 32768;
 }
 
+/** DeltaTor extension: verbosity of the measured-throughput set-selection
+ * diagnostics (ConfluxProbeLog). 0 = off, 1 = mechanism logs only, 2 =
+ * mechanism logs with tor's own log lines suppressed. */
+int
+conflux_params_get_probe_log(void)
+{
+  const or_options_t *opts = get_options();
+  if (opts && opts->ConfluxProbeLog > 0) {
+    return opts->ConfluxProbeLog;
+  }
+  return 0;
+}
+
 /** DeltaTor extension: return the slow-set RTT filter in milliseconds. 0 means
  * no filter (every acceptable set is a candidate). */
