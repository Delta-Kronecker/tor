From c6a2896c796dae9039cddc5e0c2e0daf22c0c565 Mon Sep 17 00:00:00 2001
From: DeltaTor <deltator@example.com>
Date: Fri, 13 Nov 2026 07:23:03 +0330
Subject: [PATCH] congestion: expose circuit and OR-conn buffer watermarks as
 torrc options

DeltaTor extension: add CircuitCellQueueHigh/Low and OrConnHighWater/LowWater
torrc options (0 = consensus default) that override the consensus cellq_high,
cellq_low, orconn_high and orconn_low parameters. Raising them keeps more cells
in flight per circuit and per OR connection, which improves throughput on
high-latency paths at the cost of memory.
---
 src/app/config/config.c                 | 23 +++++++++++++++++++++++
 src/app/config/or_options_st.h          | 24 ++++++++++++++++++++++++
 src/core/or/congestion_control_common.c | 18 ++++++++++++++++++
 3 files changed, 65 insertions(+)

diff --git a/src/app/config/config.c b/src/app/config/config.c
index 7f97405..95cffca 100644
--- a/src/app/config/config.c
+++ b/src/app/config/config.c
@@ -394,6 +394,10 @@ static const config_var_t option_vars_[] = {
   V(ConfluxDrainPct,             INT,      "0"),
   V(ConfluxLowExitThreshold,     INT,      "0"),
   V(ConfluxMaxOooqBytes,         INT,      "0"),
+  V(CircuitCellQueueHigh,        INT,      "0"),
+  V(CircuitCellQueueLow,         INT,      "0"),
+  V(OrConnHighWater,             INT,      "0"),
+  V(OrConnLowWater,              INT,      "0"),
   V(ConnLimit,                   POSINT,     "1000"),
   V(ConnDirectionStatistics,     BOOL,     "0"),
   V(ConstrainedSockets,          BOOL,     "0"),
@@ -3644,6 +3648,25 @@ options_validate_cb(const void *old_options_, void *options_, char **msg)
     REJECT("ConfluxMaxOooqBytes must be >= 0 (0 = consensus default)");
   }
 
+  if (options->CircuitCellQueueHigh < 0 ||
+      options->CircuitCellQueueHigh > 1000) {
+    REJECT("CircuitCellQueueHigh must be between 0 (consensus default) "
+           "and 1000 cells");
+  }
+
+  if (options->CircuitCellQueueLow < 0 || options->CircuitCellQueueLow > 1000) {
+    REJECT("CircuitCellQueueLow must be between 0 (consensus default) "
+           "and 1000 cells");
+  }
+
+  if (options->OrConnHighWater < 0) {
+    REJECT("OrConnHighWater must be >= 0 bytes (0 = consensus default)");
+  }
+
+  if (options->OrConnLowWater < 0) {
+    REJECT("OrConnLowWater must be >= 0 bytes (0 = consensus default)");
+  }
+
   if (options_validate_publish_server(old_options, options, msg) < 0)
     return -1;
 
diff --git a/src/app/config/or_options_st.h b/src/app/config/or_options_st.h
index cd5b5c4..149515e 100644
--- a/src/app/config/or_options_st.h
+++ b/src/app/config/or_options_st.h
@@ -814,6 +814,30 @@ struct or_options_t {
    * value bounds memory at the cost of more set teardowns under reordering. */
   int ConfluxMaxOooqBytes;
 
+  /** DeltaTor extension: override the consensus cellq_high, the circuit cell
+   * queue high watermark in cells. It tells us when a circuit's channel
+   * outbound queue is full. 0 (default) keeps the consensus value (256). A
+   * larger value keeps more cells in flight per circuit, improving throughput
+   * on high-latency links at the cost of memory. */
+  int CircuitCellQueueHigh;
+
+  /** DeltaTor extension: override the consensus cellq_low, the circuit cell
+   * queue low watermark in cells. Reading on the circuit's streams resumes once
+   * the queue drains to this value. 0 (default) keeps the consensus value. */
+  int CircuitCellQueueLow;
+
+  /** DeltaTor extension: override the consensus orconn_high, the OR connection
+   * outbuf high watermark in bytes. It bounds how many cells we may write onto
+   * an OR connection. 0 (default) keeps the consensus value (32 KiB). A larger
+   * value keeps the socket busy across scheduler runs and improves upload
+   * throughput at the cost of memory. */
+  int OrConnHighWater;
+
+  /** DeltaTor extension: override the consensus orconn_low, the OR connection
+   * outbuf low watermark in bytes, at which we resume writing. 0 (default)
+   * keeps the consensus value (16 KiB). */
+  int OrConnLowWater;
+
   /** The length of time that we think a consensus should be fresh. */
   int V3AuthVotingInterval;
   /** The length of time we think it will take to distribute votes. */
diff --git a/src/core/or/congestion_control_common.c b/src/core/or/congestion_control_common.c
index 0af1876..983ecbd 100644
--- a/src/core/or/congestion_control_common.c
+++ b/src/core/or/congestion_control_common.c
@@ -182,6 +182,24 @@ congestion_control_new_consensus_params(const networkstatus_t *ns)
         OR_CONN_LOWWATER_MIN,
         OR_CONN_LOWWATER_MAX);
 
+  /* DeltaTor extension: the torrc buffer-watermark options (0 = consensus
+   * default) override the consensus values. Larger buffers keep more cells in
+   * flight per circuit and per OR connection, which improves throughput on
+   * high-latency links at the cost of memory. */
+  {
+    const or_options_t *opts = get_options();
+    if (opts) {
+      if (opts->CircuitCellQueueHigh > 0)
+        cell_queue_high = opts->CircuitCellQueueHigh;
+      if (opts->CircuitCellQueueLow > 0)
+        cell_queue_low = opts->CircuitCellQueueLow;
+      if (opts->OrConnHighWater > 0)
+        or_conn_highwater = (uint32_t) opts->OrConnHighWater;
+      if (opts->OrConnLowWater > 0)
+        or_conn_lowwater = (uint32_t) opts->OrConnLowWater;
+    }
+  }
+
 #define CWND_MAX_MIN 500
 #define CWND_MAX_MAX (INT32_MAX)
   cwnd_max =
-- 
