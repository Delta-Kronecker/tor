From 7405dfcf351d241185d7ae2794837a6fcbe382b3 Mon Sep 17 00:00:00 2001
From: DeltaTor <deltator@example.com>
Date: Fri, 13 Nov 2026 07:04:01 +0330
Subject: [PATCH] conflux: expose cfx_max_oooq_bytes as ConfluxMaxOooqBytes

DeltaTor extension: add a ConfluxMaxOooqBytes torrc option (0 = consensus
default) that overrides the consensus cfx_max_oooq_bytes, the maximum number
of bytes buffered per conflux out-of-order queue before the set is torn down.
---
 src/app/config/config.c        |  5 +++++
 src/app/config/or_options_st.h |  6 ++++++
 src/core/or/conflux_params.c   | 10 ++++++++++
 3 files changed, 21 insertions(+)

diff --git a/src/app/config/config.c b/src/app/config/config.c
index 8a9a76d..7f97405 100644
--- a/src/app/config/config.c
+++ b/src/app/config/config.c
@@ -393,6 +393,7 @@ static const config_var_t option_vars_[] = {
   V(ConfluxSetRttPct,            INT,      "0"),
   V(ConfluxDrainPct,             INT,      "0"),
   V(ConfluxLowExitThreshold,     INT,      "0"),
+  V(ConfluxMaxOooqBytes,         INT,      "0"),
   V(ConnLimit,                   POSINT,     "1000"),
   V(ConnDirectionStatistics,     BOOL,     "0"),
   V(ConstrainedSockets,          BOOL,     "0"),
@@ -3639,6 +3640,10 @@ options_validate_cb(const void *old_options_, void *options_, char **msg)
            "and 100 (percent of conflux Exits required for a full set pool)");
   }
 
+  if (options->ConfluxMaxOooqBytes < 0) {
+    REJECT("ConfluxMaxOooqBytes must be >= 0 (0 = consensus default)");
+  }
+
   if (options_validate_publish_server(old_options, options, msg) < 0)
     return -1;
 
diff --git a/src/app/config/or_options_st.h b/src/app/config/or_options_st.h
index a606a1b..cd5b5c4 100644
--- a/src/app/config/or_options_st.h
+++ b/src/app/config/or_options_st.h
@@ -808,6 +808,12 @@ struct or_options_t {
    * ConfluxNumSets pool even when conflux Exits are scarce. */
   int ConfluxLowExitThreshold;
 
+  /** DeltaTor extension: override the maximum number of bytes allowed in a
+   * single conflux out-of-order queue. Above this value the set is closed.
+   * 0 (default) keeps the consensus value (effectively unlimited). A smaller
+   * value bounds memory at the cost of more set teardowns under reordering. */
+  int ConfluxMaxOooqBytes;
+
   /** The length of time that we think a consensus should be fresh. */
   int V3AuthVotingInterval;
   /** The length of time we think it will take to distribute votes. */
diff --git a/src/core/or/conflux_params.c b/src/core/or/conflux_params.c
index 577f572..448e746 100644
--- a/src/core/or/conflux_params.c
+++ b/src/core/or/conflux_params.c
@@ -422,5 +422,15 @@ conflux_params_new_consensus(const networkstatus_t *ns)
       MAX_OOO_QUEUE_BYTES_MIN,
       MAX_OOO_QUEUE_BYTES_MAX);
 
+  /* DeltaTor extension: the torrc ConfluxMaxOooqBytes option (0 = consensus
+   * default) overrides the consensus cfx_max_oooq_bytes. */
+  {
+    const or_options_t *opts = get_options();
+    if (opts && opts->ConfluxMaxOooqBytes > 0) {
+      max_ooo_queue_bytes =
+        (uint32_t) MIN(opts->ConfluxMaxOooqBytes, MAX_OOO_QUEUE_BYTES_MAX);
+    }
+  }
+
   count_exit_with_conflux_support(ns);
 }
