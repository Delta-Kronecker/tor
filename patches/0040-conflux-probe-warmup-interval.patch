+                 cfx->mthr_id, cfx->bytes_recv, interval, warmup, min_bytes);
     }
     return;
   }
 
-  /* Wait until a full window has elapsed (also tolerates a clock going
-   * backwards by simply not rolling). */
-  if (cfx->mthr_win_start > (uint64_t) now ||
-      (uint64_t) now - cfx->mthr_win_start < interval) {
+  /* Tolerate a clock going backwards by simply not rolling. */
+  if (cfx->mthr_win_start > (uint64_t) now) {
     return;
   }
-
   const uint64_t elapsed = (uint64_t) now - cfx->mthr_win_start;
+
+  /* DeltaTor: warm-up. Until the first full ConfluxProbeInterval has elapsed,
+   * re-derive the estimate every ConfluxProbeWarmupInterval seconds so selection
+   * can start adapting early. A short slice would be too noisy to trust on its
+   * own, so this uses the cumulative bytes and active time since the window
+   * opened (the baseline and window start are deliberately not advanced) and
+   * overwrites the estimate instead of smoothing it, because every value
+   * already describes the whole interval since the window opened. It never
+   * decays: a set that has not moved enough bytes yet keeps its previous
