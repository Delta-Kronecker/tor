+    } else if (conflux_mthr_detailed_logs(probe_log)) {
+      log_notice(LD_CONFLUXMTHR,
+                 "ConfluxProbe set#%"PRIu64" warmup: elapsed=%"PRIu64"s "
+                 "delta=%"PRIu64"B (low-traffic, not yet trusted)",
+                 cfx->mthr_id, elapsed, c_delta);
+    }
+    return;
+  }
