diff --git a/src/core/or/conflux_pool.c b/src/core/or/conflux_pool.c
index 228ef71..cf151e3 100644
--- a/src/core/or/conflux_pool.c
+++ b/src/core/or/conflux_pool.c
@@ -1646,6 +1646,28 @@ conflux_note_recv_activity(conflux_t *cfx)
  * measurement window is first opened. */
 static uint64_t conflux_mthr_next_id = 1;
 
+/** DeltaTor extension: length, in milliseconds, of the time the set actually
+ * delivered bytes during a window that has now lasted `elapsed_s` seconds,
+ * clamped to the wall clock so the two independent clocks cannot disagree.
+ * When no activity was recorded it returns the whole window, matching the old
+ * behaviour of dividing by the full elapsed time. */
+static uint64_t
+conflux_mthr_active_span_ms(const conflux_t *cfx, uint64_t elapsed_s)
+{
+  const bool had_activity = cfx->mthr_first_active_ms != 0 &&
+    cfx->mthr_last_active_ms >= cfx->mthr_first_active_ms;
+  uint64_t active_ms = had_activity ?
+    cfx->mthr_last_active_ms - cfx->mthr_first_active_ms : 0;
+  if (had_activity && active_ms == 0) {
+    /* A single delivered cell: keep it as a real (tiny) measurement. */
+    active_ms = 1;
+  }
+  if (active_ms > elapsed_s * 1000) {
+    active_ms = elapsed_s * 1000;
+  }
+  return active_ms ? active_ms : elapsed_s * 1000;
+}
+
 /** DeltaTor extension: fold a set's elapsed measurement window into its
  * smoothed throughput estimate. Called lazily when a new stream is placed, so
  * no timer or per-cell accounting is needed: it only reads the set's existing
@@ -1654,6 +1676,7 @@ static void
 conflux_mthr_roll_window(conflux_t *cfx, time_t now)
 {
   const uint64_t interval = (uint64_t) conflux_params_get_probe_interval();
