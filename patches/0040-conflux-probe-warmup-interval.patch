+    if (cfx->mthr_warmup_last > (uint64_t) now ||
+        (uint64_t) now - cfx->mthr_warmup_last < warmup) {
+      return;
+    }
+    cfx->mthr_warmup_last = (uint64_t) now;
+
+    const uint64_t c_delta = (cfx->bytes_recv >= cfx->mthr_prev_recv) ?
+      cfx->bytes_recv - cfx->mthr_prev_recv : 0;
+    const uint64_t c_span_ms = conflux_mthr_active_span_ms(cfx, elapsed);
+    if (c_delta >= min_bytes && c_span_ms > 0) {
+      const uint64_t bps = (c_delta * 1000) / c_span_ms;
+      cfx->mthr_bps = bps;
+      if (conflux_mthr_detailed_logs(probe_log)) {
+        log_notice(LD_CONFLUXMTHR,
+                   "ConfluxProbe set#%"PRIu64" warmup: elapsed=%"PRIu64"s "
+                   "active=%"PRIu64".%03"PRIu64"s delta=%"PRIu64"B "
+                   "bps=%"PRIu64"B/s (cumulative)",
+                   cfx->mthr_id, elapsed, c_span_ms / 1000, c_span_ms % 1000,
+                   c_delta, bps);
