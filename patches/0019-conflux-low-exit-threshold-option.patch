From 3c60e15f2890d0d863a783a218416eb2ff5bcc54 Mon Sep 17 00:00:00 2001
From: DeltaTor <deltator@example.com>
Date: Fri, 13 Nov 2026 07:03:42 +0330
Subject: [PATCH] conflux: expose cfx_low_exit_threshold as
 ConfluxLowExitThreshold

DeltaTor extension: add a ConfluxLowExitThreshold torrc option (0 = consensus
default, 1..100 = percent) that overrides the consensus cfx_low_exit_threshold.
By default the client builds only one prebuilt set when fewer than 60% of
Exits support conflux, which caps parallelism. Lowering this keeps the full
ConfluxNumSets pool alive for more parallel legs.
---
 src/app/config/config.c        |  7 +++++++
 src/app/config/or_options_st.h |  8 ++++++++
 src/core/or/conflux_params.c   | 11 +++++++++++
 3 files changed, 26 insertions(+)

diff --git a/src/app/config/config.c b/src/app/config/config.c
index 0e53742..8a9a76d 100644
--- a/src/app/config/config.c
+++ b/src/app/config/config.c
@@ -392,6 +392,7 @@ static const config_var_t option_vars_[] = {
   V(ConfluxSetRttMax,            INT,      "0"),
   V(ConfluxSetRttPct,            INT,      "0"),
   V(ConfluxDrainPct,             INT,      "0"),
+  V(ConfluxLowExitThreshold,     INT,      "0"),
   V(ConnLimit,                   POSINT,     "1000"),
   V(ConnDirectionStatistics,     BOOL,     "0"),
   V(ConstrainedSockets,          BOOL,     "0"),
@@ -3632,6 +3633,12 @@ options_validate_cb(const void *old_options_, void *options_, char **msg)
     REJECT("ConfluxDrainPct must be between 0 (consensus default) and 255");
   }
 
+  if (options->ConfluxLowExitThreshold < 0 ||
+      options->ConfluxLowExitThreshold > 100) {
+    REJECT("ConfluxLowExitThreshold must be between 0 (consensus default) "
+           "and 100 (percent of conflux Exits required for a full set pool)");
+  }
+
   if (options_validate_publish_server(old_options, options, msg) < 0)
     return -1;
 
diff --git a/src/app/config/or_options_st.h b/src/app/config/or_options_st.h
index 4170847..a606a1b 100644
--- a/src/app/config/or_options_st.h
+++ b/src/app/config/or_options_st.h
@@ -800,6 +800,14 @@ struct or_options_t {
    * set uses more than two legs so switching is not blocked. */
   int ConfluxDrainPct;
 
+  /** DeltaTor extension: override the consensus cfx_low_exit_threshold. This
+   * is the percentage of Exits in the consensus that must support conflux
+   * before the client is willing to keep a full pool of prebuilt sets; below
+   * it tor builds only a single prebuilt set. 0 (default) keeps the consensus
+   * value (currently 60%). Setting a small value lets the client keep the full
+   * ConfluxNumSets pool even when conflux Exits are scarce. */
+  int ConfluxLowExitThreshold;
+
   /** The length of time that we think a consensus should be fresh. */
   int V3AuthVotingInterval;
   /** The length of time we think it will take to distribute votes. */
diff --git a/src/core/or/conflux_params.c b/src/core/or/conflux_params.c
index fe67d50..577f572 100644
--- a/src/core/or/conflux_params.c
+++ b/src/core/or/conflux_params.c
@@ -331,6 +331,17 @@ conflux_params_new_consensus(const networkstatus_t *ns)
                             LOW_EXIT_THRESHOLD_MIN, LOW_EXIT_THRESHOLD_MAX) /
     (double)LOW_EXIT_THRESHOLD_MAX;
 
+  /* DeltaTor extension: the torrc ConfluxLowExitThreshold option (0 = consensus
+   * default, 1..100 = percent) overrides the consensus low-exit threshold.
+   * Lowering it keeps the full prebuilt-set pool even when few Exits support
+   * conflux, giving each stream more parallel legs. */
+  {
+    const or_options_t *opts = get_options();
+    if (opts && opts->ConfluxLowExitThreshold > 0) {
+      low_exit_threshold_ratio = opts->ConfluxLowExitThreshold / 100.0;
+    }
+  }
+
   max_linked_set =
     networkstatus_get_param(ns, "cfx_max_linked_set",
                             MAX_LINKED_SET_DEFAULT,
-- 
2.56.0.windows.2

